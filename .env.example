DATABASE_URL=postgres://pmo:pmo@localhost:5432/pmo
# Public base URL, used in e-mails and as the OpenAPI server.
PUBLIC_URL=http://localhost:8080
# Admins, comma-separated. Created at startup; an admin who never had a key gets one by e-mail.
ADMIN_EMAILS=you@example.com
# E-mail. Without SMTP_URL or SMTP_HOST, e-mails are only logged (bodies at RUST_LOG=debug).
# With `docker compose up`, Mailpit catches them at http://localhost:8025:
SMTP_URL=smtp://localhost:1025
# Or a server, e.g. Gmail with an app password (see README). Port 465 uses TLS, others STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=
# Default: PMO <SMTP_USERNAME>
# MAIL_FROM=PMO <pmo@localhost>
RUST_LOG=info,pmo=debug
# Attachment files (a volume in production) and the largest upload, in MB.
STORAGE_DIR=./data/attachments
MAX_UPLOAD_MB=100
# Requests per key per minute; 0 turns limiting off.
RATE_LIMIT_PER_MINUTE=600
